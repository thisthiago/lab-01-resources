ited</li>\n</ul>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678007_269967511","id":"paragraph_1744733666077_2046435262","dateCreated":"2025-05-08T20:37:58+0000","status":"READY"},{"text":"%pyspark\nfrom pyspark.sql.functions import avg\n\n\navg_likes_by_platform = (\n    df\n    .groupBy(\"platform\")\n    .agg(avg(\"likes\").alias(\"avg_likes\"))\n    .orderBy(\"avg_likes\")\n)\n\navg_likes_by_platform.show()","user":"anonymous","dateUpdated":"2025-05-08T21:15:32+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://e8aa2bb97306:4040/jobs/job?id=15"},{"jobUrl":"http://e8aa2bb97306:4040/jobs/job?id=16"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678008_1437241857","id":"paragraph_1744733832265_1356070722","dateCreated":"2025-05-08T20:37:58+0000","status":"FINISHED","focus":false,"dateFinished":"2025-05-08T21:15:28+0000","dateStarted":"2025-05-08T21:15:27+0000","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+---------+------------------+\n| platform|         avg_likes|\n+---------+------------------+\n|   Reddit|2489.1637931034484|\n|Instagram| 2554.222222222222|\n|  Twitter| 2614.832116788321|\n|   TikTok|2729.3230769230768|\n+---------+------------------+\n\n"}]}},{"text":"%md\n#### 🔢 6. Ordenamento de Dados\n🔹 Mostre os 5 prompts mais curtidos, ordenando pela coluna likes em ordem decrescente.","user":"anonymous","dateUpdated":"2025-05-08T20:37:58+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>🔢 6. Ordenamento de Dados</h4>\n<p>🔹 Mostre os 5 prompts mais curtidos, ordenando pela coluna likes em ordem decrescente.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678008_1682509487","id":"paragraph_1744733693298_673471593","dateCreated":"2025-05-08T20:37:58+0000","status":"READY"},{"text":"%pyspark\n\ntop_prompts = (\n    df\n    .select(\"prompt\", \"likes\") \n    .orderBy(col(\"likes\").desc())\n    .limit(5)\n)\n\ntop_prompts.show(truncate=False)","user":"anonymous","dateUpdated":"2025-05-08T21:16:45+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://e8aa2bb97306:4040/jobs/job?id=18"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678009_46024715","id":"paragraph_1744733835680_249225256","dateCreated":"2025-05-08T20:37:58+0000","status":"FINISHED","focus":false,"dateFinished":"2025-05-08T21:16:41+0000","dateStarted":"2025-05-08T21:16:41+0000","results":{"code":"SUCCESS","msg":[{"type":"TEXT","data":"+-------------------------------------------------+------+\n|prompt                                           |likes |\n+-------------------------------------------------+------+\n|Ghibli-style mountain with floating islands      |4944.0|\n|A lone traveler exploring an enchanted ruin      |4940.0|\n|Anime-style train passing through a fantasy world|4931.0|\n|Anime-style train passing through a fantasy world|4930.0|\n|Ghibli-style night sky with glowing stars        |4928.0|\n+-------------------------------------------------+------+\n\n"}]}},{"text":"%md\n#### ♻️ 7. Deduplicação\n🔹 Remova registros duplicados (se existirem) com base na combinação de user_id e prompt.","user":"anonymous","dateUpdated":"2025-05-08T20:37:58+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"markdown","editOnDblClick":true,"completionSupport":false},"colWidth":12,"fontSize":9,"editorHide":true,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"results":{"code":"SUCCESS","msg":[{"type":"HTML","data":"<div class=\"markdown-body\">\n<h4>♻️ 7. Deduplicação</h4>\n<p>🔹 Remova registros duplicados (se existirem) com base na combinação de user_id e prompt.</p>\n\n</div>"}]},"apps":[],"runtimeInfos":{},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678009_1654389044","id":"paragraph_1744733705848_1696369737","dateCreated":"2025-05-08T20:37:58+0000","status":"READY"},{"text":"%pyspark\ndf_deduped = df.dropDuplicates([\"user_id\", \"prompt\"])\n\ndf_deduped.show(5)","user":"anonymous","dateUpdated":"2025-05-08T21:17:44+0000","progress":0,"config":{"tableHide":false,"editorSetting":{"language":"python","editOnDblClick":false,"completionSupport":true,"completionKey":"TAB"},"colWidth":12,"fontSize":9,"editorHide":false,"results":{},"enabled":true},"settings":{"params":{},"forms":{}},"apps":[],"runtimeInfos":{"jobUrl":{"propertyName":"jobUrl","label":"SPARK JOB","tooltip":"View in Spark web UI","group":"spark","values":[{"jobUrl":"http://e8aa2bb97306:4040/jobs/job?id=23"},{"jobUrl":"http://e8aa2bb97306:4040/jobs/job?id=24"}],"interpreterSettingId":"spark"}},"progressUpdateIntervalMs":500,"jobName":"paragraph_1746736678010_307927430","id":"paragraph_1744733838711_1672976924","dateCreated":"2025-05-08T20:37:58+0000","status":"FINISHED","focus":false,"dateFinished":"2025-05-08T21:17:45+0000","dateStarted":"2025-05-08T21:17:44+0000","results":{"code